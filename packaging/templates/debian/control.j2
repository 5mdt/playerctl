Source: {{ name }}
Section: utils
Priority: optional
Maintainer: {{ maintainer.name }} <{{ maintainer.email }}>
Standards-Version: 4.6.2
Rules-Requires-Root: no
Homepage: {{ homepage }}
Build-Depends:
{% for dep in deb.build_depends %}
 {{ dep }},
{% endfor %}

Package: {{ name }}
Architecture: any
Depends: lib{{ name }}{{ soversion }} (= ${binary:Version}), ${misc:Depends}, ${shlibs:Depends}
Description: {{ summary }}
{{ description | wrap(76, ' ') }}

Package: lib{{ name }}{{ soversion }}
Section: libs
Architecture: any
Multi-Arch: same
Pre-Depends: ${misc:Pre-Depends}
Depends: ${misc:Depends}, ${shlibs:Depends}
Description: library for controlling media players (shared library)
{{ lib_description | wrap(76, ' ') }}
 .
 This package contains the shared library.

Package: gir1.2-{{ name }}-{{ api_version }}
Section: introspection
Architecture: any
Multi-Arch: same
Depends: ${gir:Depends}, ${misc:Depends}, gir1.2-glib-2.0
Description: GObject introspection data for Playerctl
{{ lib_description | wrap(76, ' ') }}
 .
 This package contains the GObject introspection data.

Package: lib{{ name }}-dev
Section: libdevel
Architecture: any
Multi-Arch: same
Depends: lib{{ name }}{{ soversion }} (= ${binary:Version}), gir1.2-{{ name }}-{{ api_version }} (= ${binary:Version}), libglib2.0-dev, ${misc:Depends}
Description: library for controlling media players (development files)
{{ lib_description | wrap(76, ' ') }}
 .
 This package contains the headers, pkg-config file and GObject introspection
 source for developing against the library.
