# Generated by scripts/render-packaging.py from packaging/package.yaml, do not edit
PKG_DISTROS = {{ distros | map(attribute='id') | join(' ') }}
{% for d in distros %}
{% if d.images is string %}
IMAGE_{{ d.id }} = {{ d.images }}
{% else %}
{% for cpu, image in d.images.items() %}
IMAGE_{{ d.id }}_{{ cpu }} = {{ image }}
{% endfor %}
IMAGE_{{ d.id }} = $(IMAGE_{{ d.id }}_$(PKG_ARCH))
{% endif %}
TYPE_{{ d.id }} = {{ d.type }}
{% endfor %}
