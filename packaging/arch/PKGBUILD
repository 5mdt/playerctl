# Maintainer: Vladimir Budylnikov <github@nett00n.org>
# The 5mdt fork of playerctl. The checksum is filled in for the released
# tarball by `make release-assets`; SKIP is only for local builds.
pkgname=playerctl-5mdt
_name=playerctl
pkgver=2.5.0
pkgrel=1
pkgdesc='Command-line utility and library for controlling MPRIS media players (5mdt fork)'
arch=(x86_64 aarch64)
url='https://github.com/5mdt/playerctl'
license=(LGPL-3.0-or-later)
depends=(glib2)
makedepends=(bash-completion glib2-devel gobject-introspection meson)
provides=("$_name=$pkgver" libplayerctl.so)
conflicts=("$_name")
source=("$_name-$pkgver.tar.xz::$url/releases/download/v$pkgver/$_name-$pkgver.tar.xz")
sha256sums=(SKIP)

build() {
  arch-meson "$_name-$pkgver" build -Dgtk-doc=false -Dbash-completions=true -Dzsh-completions=true -Dtests=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "$_name-$pkgver/LICENSE.md" -t "$pkgdir/usr/share/licenses/$pkgname"
}
